// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum SalesOrderStatus {
  PENDING
  PROCESSING
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
  CREDIT
  PAY_LATER
}

enum PaymentPlatform {
  KHALTI
  ESEWA
  FONEPAY
  OTHER
}

enum CustomerType {
  NEW
  REGULAR
  VIP
}

enum CreditStatus {
  PAID
  PARTIAL
  OVERDUE
  PENDING
}

enum ProductType {
  JAR_20L
  BOTTLE_500ML
  BOTTLE_1L
  OTHER
}

enum StockAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum AdjustmentType {
  DAMAGE
  EXPIRED
  CORRECTION
  THEFT
  RETURN
  OTHER
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  CREDIT_DUE
  ORDER_UPDATE
  SUPPLIER_DELAY
  PAYMENT_RECEIVED
  APPROVAL_REQUEST
  SYSTEM_WARNING
  STOCK_ADJUSTMENT
  DELIVERY_UPDATE
  NEW_ORDER
  USER_CREATED
  USER_STATUS_CHANGE
  USER_ROLE_CHANGE
  PASSWORD_CHANGE
  PROFILE_CHANGE_REQUEST
}

enum NotificationPriority {
  CRITICAL
  WARNING
  INFORMATION
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReportType {
  SALES
  FINANCIAL
  INVENTORY
  CUSTOMER
  SUPPLIER
  EMPLOYEE
}

enum ReportPeriod {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileChangeField {
  NAME
  EMAIL
  PHONE
  PROFILE_IMAGE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ==================== USER MODEL ====================

model User {
  id                      String                    @id @default(uuid())
  name                    String
  email                   String                    @unique
  password                String
  role                    Role                      @default(STAFF)
  isActive                Boolean                   @default(true)
  phone                   String?
  profileImage            String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  // Relations
  stockTransactions       StockTransaction[]
  purchaseOrders          PurchaseOrder[]           @relation("PurchaseOrderCreator")
  approvedOrders          PurchaseOrder[]           @relation("PurchaseOrderApprover")
  cancelledOrders         PurchaseOrder[]           @relation("PurchaseOrderCanceller")
  salesOrders             SalesOrder[]
  auditLogs               AuditLog[]
  creditPayments          CreditPayment[]
  requestedAdjustments    StockAdjustment[]         @relation("RequestedAdjustments")
  approvedAdjustments     StockAdjustment[]         @relation("ApprovedAdjustments")
  staffPerformance        StaffPerformance[]
  notifications           Notification[]
  notificationPref        NotificationPreference?
  savedReports            SavedReport[]
  purchaseOrderPayments   PurchaseOrderPayment[]
  goodsReceivingNotes     GoodsReceivingNote[]
  purchaseOrderInvoices   PurchaseOrderInvoice[]
  productionBatchesCreated ProductionBatch[]        @relation("ProductionCreator")
  profileChangeRequests   ProfileChangeRequest[]    @relation("ProfileChangeRequester")
  reviewedProfileRequests ProfileChangeRequest[]    @relation("ProfileReviewer")
  salesInvoices           SalesInvoice[]            @relation("SalesInvoiceCreator")
  purchaseInvoices        PurchaseInvoice[]         @relation("PurchaseInvoiceCreator")
}

// ==================== ORDER COUNTER TABLE ====================

model OrderCounter {
  id          String   @id @default(uuid())
  prefix      String   // "SO", "PO", "SINV", "PINV", "CP" (Credit Payment)
  date        String   // "20260715"
  lastNumber  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([prefix, date])
  @@index([prefix, date])
}

// ==================== PRODUCT CATEGORY ====================

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

// ==================== RAW MATERIAL CATEGORY ====================

model RawMaterialCategory {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  icon          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rawMaterials  RawMaterial[]
  suppliers     Supplier[]    @relation("SupplierCategories")
}

// ==================== SUPPLIER MODEL ====================

model Supplier {
  id                 String          @id @default(uuid())
  name               String
  contactPerson      String?
  email              String?
  phone              String
  address            String?
  productCategories  String[]
  paymentTerms       String?
  status             String          @default("Active")
  performanceRating  Float           @default(4.0)
  bankName           String?
  bankAccountNumber  String?
  bankAccountName    String?
  bankBranch         String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  rawMaterials       RawMaterial[]
  purchaseOrders     PurchaseOrder[]
  products           Product[]
  categories         RawMaterialCategory[] @relation("SupplierCategories")
  purchaseInvoices   PurchaseInvoice[]
}

// ==================== RAW MATERIAL MODEL ====================

model RawMaterial {
  id                  String                    @id @default(uuid())
  name                String
  sku                 String?                   @unique
  description         String?
  unit                String                    @default("piece")
  categoryId          String
  category            RawMaterialCategory       @relation(fields: [categoryId], references: [id])
  currentStock        Int                       @default(0)
  reorderLevel        Int                       @default(10)
  unitCost            Float?
  supplierId          String?
  supplier            Supplier?                 @relation(fields: [supplierId], references: [id])
  imageUrl            String?
  imagePublicId       String?
  status              String                    @default("Active")
  isArchived          Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  purchaseOrderItems  PurchaseOrderRawMaterial[]
  stockTransactions   StockTransaction[]
  goodsReceivingItems GoodsReceivingRawMaterial[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([status])
  @@index([isArchived])
}

// ==================== PRODUCT MODEL ====================

model Product {
  id                 String              @id @default(uuid())
  name               String
  sku                String?             @unique
  description        String?
  imageUrl           String?
  imagePublicId      String?
  unit               String              @default("piece")
  type               ProductType         @default(OTHER)
  reorderLevel       Int                 @default(10)
  currentStock       Int                 @default(0)
  costPrice          Float?
  sellingPrice       Float?
  productionCost     Float?
  categoryId         String
  category           ProductCategory     @relation(fields: [categoryId], references: [id])
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  stockAdjustments   StockAdjustment[]
  inventoryMovements InventoryMovement[]
  productionBatches  ProductionBatch[]
  creditPaymentDetails CreditPaymentDetail[]
  salesInvoiceItems  SalesInvoiceItem[]
}

// ==================== SALES INVOICE ====================

model SalesInvoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique
  salesOrderId    String         @unique
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  invoiceDate     DateTime       @default(now())
  dueDate         DateTime?
  subtotal        Float          @default(0)
  discount        Float          @default(0)
  tax             Float          @default(0)
  totalAmount     Float          @default(0)
  status          InvoiceStatus  @default(DRAFT)
  notes           String?
  pdfUrl          String?
  createdById     String
  createdBy       User           @relation("SalesInvoiceCreator", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           SalesInvoiceItem[]

  @@index([salesOrderId])
  @@index([customerId])
  @@index([invoiceNumber])
  @@index([status])
}

// ==================== SALES INVOICE ITEMS ====================

model SalesInvoiceItem {
  id              String      @id @default(uuid())
  invoiceId       String
  invoice         SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id])
  description     String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  createdAt       DateTime    @default(now())

  @@index([invoiceId])
  @@index([productId])
}

// ==================== PURCHASE INVOICE ====================

model PurchaseInvoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique
  purchaseOrderId String         @unique
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  invoiceDate     DateTime       @default(now())
  dueDate         DateTime?
  subtotal        Float          @default(0)
  discount        Float          @default(0)
  tax             Float          @default(0)
  totalAmount     Float          @default(0)
  status          InvoiceStatus  @default(DRAFT)
  notes           String?
  pdfUrl          String?
  createdById     String
  createdBy       User           @relation("PurchaseInvoiceCreator", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           PurchaseInvoiceItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([invoiceNumber])
  @@index([status])
}

// ==================== PURCHASE INVOICE ITEMS ====================

model PurchaseInvoiceItem {
  id              String      @id @default(uuid())
  invoiceId       String
  invoice         PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rawMaterialId   String?
  rawMaterial     RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  description     String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  createdAt       DateTime    @default(now())

  @@index([invoiceId])
  @@index([rawMaterialId])
}

// ==================== PURCHASE ORDER MODELS ====================

model PurchaseOrder {
  id                   String               @id @default(uuid())
  orderNumber          String               @unique
  supplierId           String
  supplier             Supplier             @relation(fields: [supplierId], references: [id])
  status               PurchaseOrderStatus  @default(PENDING)
  paymentStatus        String               @default("UNPAID")
  expectedDeliveryDate DateTime?
  deliveredAt          DateTime?
  deliveredOnTime      Boolean?
  warehouseDestination String?
  subtotal             Float?               @default(0)
  discount             Float?               @default(0)
  tax                  Float?               @default(0)
  totalAmount          Float?               @default(0)
  notes                String?
  invoiceUrl           String?
  createdById          String
  createdBy            User                 @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orderDate            DateTime             @default(now())
  approvedById         String?
  approvedBy           User?                @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  cancelledById        String?
  cancelledBy          User?                @relation("PurchaseOrderCanceller", fields: [cancelledById], references: [id])
  cancelledAt          DateTime?
  items                PurchaseOrderRawMaterial[]
  goodsReceivingNotes  GoodsReceivingNote[]
  payments             PurchaseOrderPayment[]
  purchaseOrderItems   PurchaseOrderItem[]
  invoices             PurchaseOrderInvoice[]
  purchaseInvoice      PurchaseInvoice?     // ✅ Relation to purchase invoice (NO @relation with fields)
}

model PurchaseOrderInvoice {
  id              String          @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  imageUrl        String
  imagePublicId   String?
  fileName        String?
  fileSize        Int?
  uploadedById    String
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([purchaseOrderId])
  @@index([createdAt])
}

model PurchaseOrderRawMaterial {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  rawMaterialId   String
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  damagedQty      Int           @default(0)
  unitPrice       Float?
  totalPrice      Float?
  remarks         String?

  @@index([purchaseOrderId])
  @@index([rawMaterialId])
}

model PurchaseOrderPayment {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  amount          Float
  paymentMethod   String
  transactionId   String?       @unique
  paymentDate     DateTime      @default(now())
  recordedById    String
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([paymentDate])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Float?
}

// ==================== GOODS RECEIVING NOTE MODELS ====================

model GoodsReceivingNote {
  id              String                    @id @default(uuid())
  grnNumber       String                    @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String
  receivedBy      User                      @relation(fields: [receivedById], references: [id])
  receivedDate    DateTime                  @default(now())
  notes           String?
  items           GoodsReceivingRawMaterial[]
  createdAt       DateTime                  @default(now())

  @@index([purchaseOrderId])
  @@index([grnNumber])
}

model GoodsReceivingRawMaterial {
  id                String        @id @default(uuid())
  grnId             String
  grn               GoodsReceivingNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  orderedQty        Int
  previouslyReceived Int         @default(0)
  receivedQty       Int
  damagedQty        Int          @default(0)
  acceptedQty       Int
  remarks           String?

  @@index([grnId])
  @@index([rawMaterialId])
}

// ==================== STOCK TRANSACTIONS ====================

model StockTransaction {
  id            String               @id @default(uuid())
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id])
  rawMaterialId String?
  rawMaterial   RawMaterial?         @relation(fields: [rawMaterialId], references: [id])
  type          StockTransactionType
  quantity      Int
  previousStock Int
  newStock      Int
  note          String?
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  createdAt     DateTime             @default(now())
}

// ==================== SALES & CUSTOMER MODELS ====================

model Customer {
  id                 String          @id @default(uuid())
  name               String
  email              String?
  phone              String
  address            String?
  deliveryAddress    String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  salesOrders        SalesOrder[]
  outstandingCredit  Float           @default(0)
  customerType       CustomerType    @default(REGULAR)
  creditLimit        Float?          @default(0)
  creditAccount      CreditAccount?
  salesInvoices      SalesInvoice[]
}

model SalesOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  status      SalesOrderStatus @default(PENDING)
  totalAmount Float?
  notes       String?
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       SalesOrderItem[]
  delivery    Delivery?
  payment     Payment?
  salesInvoice SalesInvoice?   // ✅ NO @relation with fields here
  creditPayments CreditPaymentDetail[]
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Float?
  totalPrice   Float?
}

model Delivery {
  id           String         @id @default(uuid())
  salesOrderId String         @unique
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id])
  status       DeliveryStatus @default(PENDING)
  deliveryDate DateTime?
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ==================== PAYMENT MODEL ====================

model Payment {
  id                    String          @id @default(uuid())
  salesOrderId          String          @unique
  salesOrder            SalesOrder      @relation(fields: [salesOrderId], references: [id])
  method                PaymentMethod   @default(CASH)
  platform              PaymentPlatform?
  platformTransactionId String?
  status                PaymentStatus   @default(PENDING)
  amount                Float
  khaltiPidx            String?         @unique
  khaltiTransactionId   String?
  verifiedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([salesOrderId])
  @@index([status])
  @@index([platform])
}

// ==================== CREDIT MODELS (UPDATED WITH AUTO-INCREMENT) ====================

model CreditAccount {
  id                String        @id @default(uuid())
  customerId        String        @unique
  customer          Customer      @relation(fields: [customerId], references: [id])
  
  // Financial tracking
  totalCredit       Float         @default(0)      // Total credit amount (principal)
  paidAmount        Float         @default(0)      // Total paid so far
  remainingBalance  Float         @default(0)      // Total credit - paidAmount
  
  // Payment terms
  dueDate           DateTime                        // When payment is due
  status            CreditStatus  @default(PENDING) // PAID, PARTIAL, OVERDUE, PENDING
  
  // Metadata
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  payments          CreditPayment[]
}

model CreditPayment {
  id                    String            @id @default(uuid())
  creditAccountId       String
  creditAccount         CreditAccount     @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)
  
  // Payment details
  amount                Float             // Amount paid in this installment
  paymentMethod         String            // CASH, ONLINE, BANK_TRANSFER
  paymentPlatform       String?           // KHALTI, ESEWA, etc. (if ONLINE)
  platformTransactionId String?           // Transaction ID from platform
  paymentDate           DateTime          @default(now())
  
  // ✅ Auto-increment fields
  transactionId         String?           @unique // Internal transaction ID (legacy)
  creditPaymentNumber   String?           @unique // ✅ Auto-incremented payment number (CP-YYYYMMDD-XXXX)
  
  // Additional info
  notes                 String?           // e.g., "1st installment", "Full payment"
  status                String            @default("COMPLETED")
  
  // Audit
  recordedById          String
  recordedBy            User              @relation(fields: [recordedById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  // Relations
  paymentDetails        CreditPaymentDetail[]

  @@index([creditAccountId])
  @@index([paymentDate])
  @@index([status])
  @@index([recordedById])
  @@index([transactionId])
  @@index([creditPaymentNumber]) // ✅ Index for faster lookup
}

model CreditPaymentDetail {
  id                String          @id @default(uuid())
  paymentId         String
  payment           CreditPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  // Order and product details
  salesOrderId      String
  salesOrder        SalesOrder      @relation(fields: [salesOrderId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  
  // Quantity and pricing
  quantity          Int
  unitPrice         Float
  totalPrice        Float           // Allocated amount for this product
  
  // Metadata
  createdAt         DateTime        @default(now())

  @@index([paymentId])
  @@index([salesOrderId])
  @@index([productId])
}

// ==================== STOCK ADJUSTMENT ====================

model StockAdjustment {
  id                String                @id @default(uuid())
  requestNumber     String                @unique
  productId         String
  product           Product               @relation(fields: [productId], references: [id])
  itemType          String                @default("PRODUCT")
  adjustmentType    AdjustmentType        @default(CORRECTION)
  currentStock      Int
  requestedQuantity Int
  newStock          Int
  reason            String
  status            StockAdjustmentStatus @default(PENDING)
  notes             String?
  imageUrl          String?
  imagePublicId     String?
  requestedById     String
  requestedBy       User                  @relation("RequestedAdjustments", fields: [requestedById], references: [id])
  approvedById      String?
  approvedBy        User?                 @relation("ApprovedAdjustments", fields: [approvedById], references: [id])
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  approvedAt        DateTime?
  completedAt       DateTime?

  @@index([productId])
  @@index([status])
  @@index([requestedById])
  @@index([adjustmentType])
  @@index([createdAt])
}

// ==================== STAFF PERFORMANCE ====================

model StaffPerformance {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  month             DateTime  @default(now())
  ordersProcessed   Int       @default(0)
  revenueGenerated  Float     @default(0)
  deliveriesCompleted Int     @default(0)
  creditCollected   Float     @default(0)
  performanceScore  Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, month])
  @@index([month])
}

// ==================== PROFILE CHANGE REQUEST ====================

model ProfileChangeRequest {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation("ProfileChangeRequester", fields: [userId], references: [id])
  field           ProfileChangeField
  currentValue    String?
  requestedValue  String
  status          ProfileChangeStatus   @default(PENDING)
  reason          String?
  adminNotes      String?
  reviewedById    String?
  reviewedBy      User?                 @relation("ProfileReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id            String              @id @default(uuid())
  title         String
  message       String
  type          NotificationType
  priority      NotificationPriority @default(INFORMATION)
  isRead        Boolean             @default(false)
  userId        String?
  user          User?               @relation(fields: [userId], references: [id])
  referenceId   String?
  referenceType String?
  emailSent     Boolean             @default(false)
  emailSentAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  emailLogs     EmailLog[]

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([referenceId])
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id])
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  inAppNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  lowStockAlerts        Boolean  @default(true)
  outOfStockAlerts      Boolean  @default(true)
  creditDueAlerts       Boolean  @default(true)
  supplierDelayAlerts   Boolean  @default(false)
  orderUpdates          Boolean  @default(false)
  systemWarnings        Boolean  @default(true)
  approvalRequests      Boolean  @default(true)
  stockAdjustments      Boolean  @default(false)
  deliveryUpdates       Boolean  @default(false)
  criticalAlerts        Boolean  @default(true)
  warningAlerts         Boolean  @default(true)
  infoAlerts            Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model EmailLog {
  id              String      @id @default(uuid())
  notificationId  String
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientEmail  String
  recipientName   String?
  subject         String
  status          EmailStatus @default(PENDING)
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime    @default(now())

  @@index([notificationId])
  @@index([status])
  @@index([sentAt])
}

// ==================== INVENTORY MOVEMENT ====================

model InventoryMovement {
  id            String           @id @default(uuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  type          StockTransactionType
  quantity      Int
  previousStock Int
  newStock      Int
  referenceId   String?
  notes         String?
  createdAt     DateTime         @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// ==================== SAVED REPORTS ====================

model SavedReport {
  id          String       @id @default(uuid())
  name        String
  type        ReportType
  period      ReportPeriod
  startDate   DateTime
  endDate     DateTime
  filters     Json?
  generatedBy String
  generator   User         @relation(fields: [generatedBy], references: [id])
  fileUrl     String?
  createdAt   DateTime     @default(now())
  expiresAt   DateTime?

  @@index([type])
  @@index([createdAt])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())
  userName    String?
  userRole    String?
  module      String?
  description String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([entity])
  @@index([module])
}

// ==================== PRODUCTION MODEL ====================

model ProductionBatch {
  id                String    @id @default(uuid())
  batchNumber       String    @unique
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  quantityProduced  Int
  unit              String    @default("piece")
  rawMaterialsUsed  Json
  startDate         DateTime?
  notes             String?
  createdById       String
  createdBy         User      @relation("ProductionCreator", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([productId])
  @@index([batchNumber])
  @@index([createdAt])
}